{
  "name": "controle-logistica-ts",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "concurrently -n api,anpr -c blue,green \"nest start\" \"npm run anpr:start\"",
    "start:dev": "concurrently -n api,anpr -c blue,green \"nest start --watch\" \"npm run anpr:start\"",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "anpr:start": "node scripts/python.mjs -m uvicorn app.main:app --host 127.0.0.1 --port 8000",
    "seed:admin": "nest build && node --env-file=.env dist/seed/admin.seed.js",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:ci": "npm run lint && npm run typecheck && npm run test:cov && npm run test:e2e && npm run test:python",
    "typecheck": "tsc --noEmit --incremental false",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:init": "npm run build && node --env-file-if-exists=.env scripts/init-db.mjs",
    "seed:cameras": "node --env-file-if-exists=.env scripts/seed-cameras.mjs",
    "test:python": "node scripts/python.mjs -m pytest --cov=app --cov-branch --cov-report=term-missing --cov-fail-under=95"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/observe": "^0.1.8",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "bcryptjs": "^3.0.3",
    "minio": "^8.0.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.2",
    "zod-nest": "^3.6.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^10.0.5",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
