# Idioma do PaddleOCR
ANPR_LANG=en

# Modelo de leitura usado nos recortes YOLO. Vazio = usa exatamente o modelo de
# reconhecimento que o PaddleOCR instalado seleciona para ANPR_LANG.
# ANPR_TEXT_RECOGNITION_MODEL=
# Quando o leitor direto nao encontra placa, repete o recorte pelo pipeline
# completo do PaddleOCR (melhor para placas de duas linhas/inclinadas).
# ANPR_CROP_PIPELINE_FALLBACK=false
# Pre-carrega os modelos na inicializacao em vez de no primeiro veiculo.
# ANPR_WARMUP=true

# Filtro de cena: so roda OCR quando a imagem muda; redes de seguranca garantem
# uma inferencia a cada ANPR_FORCE_PROBE_SECONDS mesmo em cena estatica.
# ANPR_SCENE_FILTER=true
# Diferenca media minima (0-255) para considerar que a cena mudou.
# ANPR_SCENE_CHANGE_THRESHOLD=2
# Atualizacao forcada maxima (s) sem mudanca visual.
# ANPR_FORCE_PROBE_SECONDS=1
# Teto absoluto (s) entre capturas. Se for menor que o intervalo configurado na
# camera, forca captura mais rapida (ex.: 0.25 = ate 4 FPS).
# ANPR_IDLE_CAPTURE_MAX_SECONDS=0.25

# Deteccao YOLO (vazio = auto: weights/best.pt local, senao download do HuggingFace)
# ANPR_YOLO_MODEL=
# Resolucao de inferencia do YOLO (px); maior = mais preciso, porem mais lento e
# mais memoria. 480 e um bom equilibrio em maquinas com pouca RAM.
# ANPR_YOLO_IMGSZ=480
# Confianca minima de deteccao (0-1)
# ANPR_YOLO_CONF=0.25

# Numero de threads nativas (OpenMP/MKL) usadas por PyTorch e Paddle. Com o
# ANPR na mesma maquina do Nest/Postgres, 6 deixa margem para o restante.
# ANPR_NATIVE_THREADS=6
# oneDNN/MKLDNN acelera o OCR em CPU; desligue se houver instabilidade nativa.
# ANPR_MKLDNN=true

# Fallback do PaddleOCR na imagem inteira quando o YOLO nao detecta. Desligado
# por padrao: economiza memoria/tempo (o caminho YOLO cobre a maioria dos frames).
# ANPR_FULL_FRAME_FALLBACK=false

# Pre-processamento antes do OCR (CLAHE + reducao de ruido + upscale dos recortes)
# ANPR_PREPROCESSAR=true
# Altura minima (px) dos recortes de placa antes do OCR; 0 desativa o upscale
# ANPR_UPSCALE_ALTURA_MIN=64
# Fracao de cada borda recortada antes da deteccao (0-0.4).
# Remove overlays da camera (nome do canal, data/hora) que o OCR confunde com placa.
# ANPR_CROP_BORDAS_PERCENT=0.10
# Tempo (s) que cada leitura de placa vale na votacao. A janela total de
# confirmacao e confirmation_reads * este valor (ex.: 2 * 10 = 20 s).
# ANPR_READ_TTL_SECONDS=10
