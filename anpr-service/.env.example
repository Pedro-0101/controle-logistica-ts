# Idioma do PaddleOCR
ANPR_LANG=en

# Deteccao YOLO (vazio = auto: weights/best.pt local, senao download do HuggingFace)
# ANPR_YOLO_MODEL=
# Resolucao de inferencia do YOLO (px); maior = mais preciso, porem mais lento e
# mais memoria. 480 e um bom equilibrio em maquinas com pouca RAM.
# ANPR_YOLO_IMGSZ=480
# Confianca minima de deteccao (0-1)
# ANPR_YOLO_CONF=0.25

# Numero de threads nativas (OpenMP/MKL) usadas por PyTorch e Paddle. 1 reduz
# drasticamente o consumo de memoria em maquinas pequenas.
# ANPR_NATIVE_THREADS=1

# Fallback do PaddleOCR na imagem inteira quando o YOLO nao detecta. Desligado
# por padrao: economiza memoria/tempo (o caminho YOLO cobre a maioria dos frames).
# ANPR_FULL_FRAME_FALLBACK=false

# Pre-processamento antes do OCR (CLAHE + reducao de ruido + upscale dos recortes)
# ANPR_PREPROCESSAR=true
# Altura minima (px) dos recortes de placa antes do OCR; 0 desativa o upscale
# ANPR_UPSCALE_ALTURA_MIN=64
# Fracao de cada borda recortada antes da deteccao (0-0.4).
# Remove overlays da camera (nome do canal, data/hora) que o OCR confunde com placa.
# ANPR_CROP_BORDAS_PERCENT=0.10
# Tempo (s) que cada leitura de placa vale na votacao. A janela total de
# confirmacao e confirmation_reads * este valor (ex.: 2 * 10 = 20 s).
# ANPR_READ_TTL_SECONDS=10
