# Idioma do PaddleOCR
ANPR_LANG=en

# Detecção YOLO (vazio = auto: weights/best.pt local, senão download do HuggingFace)
# ANPR_YOLO_MODEL=
# Resolução de inferência do YOLO (px); maior = mais preciso, porém mais lento
# ANPR_YOLO_IMGSZ=640
# Confiança mínima de detecção (0-1)
# ANPR_YOLO_CONF=0.25

# Pré-processamento antes do OCR (CLAHE + redução de ruído + upscale dos recortes)
# ANPR_PREPROCESSAR=true
# Altura mínima (px) dos recortes de placa antes do OCR; 0 desativa o upscale
# ANPR_UPSCALE_ALTURA_MIN=64
# Fração de cada borda recortada antes da detecção (0-0.4).
# Remove overlays da câmera (nome do canal, data/hora) que o OCR confunde com placa.
# ANPR_CROP_BORDAS_PERCENT=0.10
# Tempo (s) que cada leitura de placa vale na votação. A janela total de
# confirmação é confirmation_reads × este valor (ex.: 2 × 10 = 20 s).
# ANPR_READ_TTL_SECONDS=10
